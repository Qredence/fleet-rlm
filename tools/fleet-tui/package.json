{
  "name": "@qredence/fleet-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "test": "vitest run",
    "bench:tui": "tsx src/tui/transcript.bench.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write src",
    "format:check": "biome ci --linter-enabled=false --assist-enabled=false src",
    "lint": "biome lint src"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.80.10",
    "ai": "7.0.22",
    "highlight.js": "10.7.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@types/node": "22.19.19",
    "openapi-typescript": "7.10.1",
    "tsx": "4.22.0",
    "typescript": "5.8.3",
    "vitest": "4.0.18"
  }
}
