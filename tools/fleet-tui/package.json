{
  "name": "@qredence/fleet-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/cli.tsx",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write src",
    "format:check": "biome ci --linter-enabled=false --assist-enabled=false src",
    "lint": "biome lint src"
  },
  "dependencies": {
    "ai": "7.0.22",
    "ink": "7.1.0",
    "marked": "14.1.3",
    "react": "19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.2",
    "openapi-typescript": "7.10.1",
    "tsx": "4.22.0",
    "typescript": "5.8.3",
    "vitest": "4.0.18"
  }
}
