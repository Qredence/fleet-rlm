{
  "name": "@qredence/fleet-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "test": "env COLORTERM=truecolor vitest run",
    "bench:tui": "tsx src/tui/transcript.bench.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write src",
    "format:check": "biome ci --linter-enabled=false --assist-enabled=false src",
    "lint": "biome lint src"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "1.0.3",
    "highlight.js": "11.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.15",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.2"
  },
  "packageManager": "pnpm@12.6.0"
}
