{
  "name": "@qredence/fleet-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "test": "vitest run",
    "bench:tui": "tsx src/tui/transcript.bench.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write src",
    "format:check": "biome ci --linter-enabled=false --assist-enabled=false src",
    "lint": "biome lint src"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.84.0",
    "highlight.js": "10.7.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "22.20.1",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.33.2"
}
