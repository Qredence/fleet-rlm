# Copy to config/fleet.toml and customize locally. Never add credentials here.
# Fleet non-secret process defaults. Environment/.env override this file.
# Values are a provisional baseline, not performance-tuned defaults.
# Credentials: DATABRICKS_TOKEN, FLEET_DAYTONA_API_KEY,
# FLEET_TYPESAFE_API_KEY and FLEET_DATABASE_URL belong in .env/environment.
# FLEET_DATABASE_MIGRATION_URL is an optional secret-only DDL-role DSN.
[config]
schema_version = 5

[runtime]
execution_mode = "hybrid"
# 0 = no Fleet Turn deadline; provider TTL and idle bounds still apply.
turn_timeout_seconds = 0
max_llm_calls_per_turn = 150
max_agent_depth = 3
max_child_sandboxes = 8
max_active_children = 4
max_active_sessions = 64
linked_children = true

# Root/sub default to openai/system.ai.deepseek-v4-1-flash-1017.
# An explicit shared model overrides all roles without their own model.
# Provider credentials may be exported in the environment.
[llm]
# model = "openai/gpt-4o-mini"
# api_base = "https://your-compatible-endpoint.example/v1"
# api_key_env = "MY_PROVIDER_KEY"
adapter = "chat"
# Set adapter = "json" together with response_format = "json_object" to request JSON mode.
response_format = "auto"

[llm.root]
max_tokens = 16384

[llm.reflection]
temperature = 1.0
max_tokens = 32000
# An explicit model starts an independent connection:
# model = "anthropic/claude-sonnet-4-5"
# api_key_env = "ANTHROPIC_API_KEY"

[decision]
model = "jev-1.14.0"

[daytona]
auto_stop_minutes = 30
shared_notes_subpath = "shared/learned-notes"
# Set org_id/volume_id here or FLEET_DAYTONA_ORG_ID/FLEET_DAYTONA_VOLUME_ID.
# The historical volume_name = "fleet-rlm-architecture" was NOT a Volume ID.

[storage]
max_upload_bytes = 25000000
compiled_program_dir = ".fleet/compiled"
local_skills_dir = ".fleet/skills"
lakebase_endpoint = ""
database_schema = "fleet_rlm_lite"

# Local MLflow is managed by `fleet cli`. Standalone commands connect to it.
[mlflow]
mode = "local"

[mlflow.local]
port = 5001
data_dir = ".fleet/mlflow"
experiment_name = "fleet-rlm-dev"
eval_experiment_name = "fleet-rlm-eval"
optimization_experiment_name = "fleet-rlm-gepa"

# Select with `fleet cli databricks` or --mlflow databricks.
[mlflow.databricks]
tracking_uri = "databricks"
experiment_name = "/Shared/fleet-rlm-runtime"
eval_experiment_name = "/Shared/fleet-rlm-eval"
eval_trace_table_prefix = "fleet_rlm_eval"
optimization_experiment_name = "/Shared/fleet-rlm-gepa"
trace_catalog = "example_catalog"
trace_schema = "fleet_observability"
trace_table_prefix = "fleet_rlm_runtime"
tracing_sql_warehouse_id = "" # Set your SQL warehouse ID before selecting Databricks.
optimization_trace_schema = "fleet_gepa"
optimization_trace_table_prefix = "fleet_rlm_gepa"

[llm.judge]
temperature = 0.0
cache = true

[evaluation]
# openai:/<service-id> judges route through the AI Gateway with DATABRICKS_TOKEN.
judge_model = "openai:/gpt-4o-mini"

[server]
host = "127.0.0.1"
port = 8000
allow_non_loopback_bind = false
