{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp/oauth"
    },
    "daytona": {
      "type": "local",
      "command": "daytona",
      "args": [
        "mcp",
        "start"
      ]
    },
    "mlflow-mcp": {
      "command": "uv",
      "args": [
        "run",
        "--with",
        "mlflow[mcp]>=3.17.1",
        "mlflow",
        "mcp",
        "run"
      ],
      "env": {
        "MLFLOW_TRACKING_URI": "http://localhost:5001"
      }
    }
  }
}
