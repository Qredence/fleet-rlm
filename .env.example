# Fleet RLM backend

# Hermetic is the default. Select Daytona explicitly for provider execution.
FLEET_RUN_ENVIRONMENT=hermetic
FLEET_DATA_ROOT=.fleet_rlm
FLEET_APP_NAME=fleet-rlm

# Required for live composition.
# Local development uses SQLite. Use PostgreSQL only for an explicitly
# authorized disposable/live database lane.
FLEET_DATABASE_URL=sqlite+aiosqlite:///./.fleet_rlm/local.sqlite3
FLEET_DAYTONA_API_KEY=
FLEET_LLM_API_KEY=

# DSPy model roles.
FLEET_ROOT_MODEL=openai/gpt-4o-mini
FLEET_SUB_MODEL=openai/gpt-4o-mini
FLEET_LLM_BASE_URL=
FLEET_LLM_MAX_TOKENS=

# Daytona Workspace Volume Scope.
FLEET_VOLUME_NAME=rlm-volume-dspy
FLEET_VOLUME_MOUNT_PATH=/home/daytona/fleet

# Files and bounded sizes.
FLEET_MAX_UPLOAD_BYTES=10485760
FLEET_MAX_ARTIFACT_BYTES=10485760
FLEET_BUDGET_MAX_ITERATIONS=6
FLEET_BUDGET_MAX_LLM_CALLS=16
FLEET_BUDGET_MAX_OUTPUT_CHARS=3000
FLEET_BUDGET_MAX_WALL_SECONDS=900
FLEET_BUDGET_MAX_SUB_LM_CONCURRENCY=8
FLEET_BUDGET_MAX_TOOL_CALLS=32
FLEET_BUDGET_MAX_SKILL_LOADS=8
FLEET_RUN_HEARTBEAT_SECONDS=10
FLEET_RUN_STALE_AFTER_SECONDS=60

# Authentication: dev permits synthetic X-Fleet-* headers; neon requires JWT.
FLEET_AUTH_MODE=dev
FLEET_NEON_AUTH_URL=
FLEET_NEON_TENANT_CLAIM=
