# Fleet RLM profile selection and values explicitly referenced by
# config/fleet.toml. Non-secret runtime policy belongs in TOML; profile changes
# require a process restart.
FLEET_CONFIG_PROFILE=daytona

# The default policy resolves these names for local storage and Daytona.
FLEET_DATABASE_URL=sqlite+aiosqlite:///./.fleet_rlm/local.sqlite3
FLEET_DAYTONA_API_KEY=
# `local-deno` uses FLEET_LLM_API_KEY. Daytona profiles use DATABRICKS_TOKEN
# for both configured DeepSeek model roles.
FLEET_LLM_API_KEY=
DATABRICKS_TOKEN=

# Databricks SDK authentication is external to Fleet's policy resolver and is
# required by the standard Daytona profiles for AI Gateway and Managed MLflow.
# DATABRICKS_HOST=https://<workspace-host>
# The standard Daytona policy declares these workspace-specific, non-secret
# connection and trace-routing values by name; set them here or in process env.
FLEET_DATABRICKS_AI_GATEWAY_BASE_URL=
FLEET_MLFLOW_EXPERIMENT_NAME=
FLEET_MLFLOW_TRACE_CATALOG=
FLEET_MLFLOW_TRACE_SCHEMA=
FLEET_MLFLOW_TRACE_TABLE_PREFIX=
FLEET_MLFLOW_TRACING_SQL_WAREHOUSE_ID=
