# Fleet RLM backend

# Daytona is the default. Select Deno for the canonical reduced local runtime.
FLEET_RUN_ENVIRONMENT=daytona
FLEET_DATA_ROOT=.fleet_rlm
FLEET_APP_NAME=fleet-rlm

# Deno requires the LLM key and may use local SQLite. Daytona additionally
# requires the database URL and Daytona key; use PostgreSQL only for an
# explicitly authorized disposable/live database lane.
FLEET_DATABASE_URL=sqlite+aiosqlite:///./.fleet_rlm/local.sqlite3
FLEET_DAYTONA_API_KEY=
FLEET_DAYTONA_SNAPSHOT=fleet-rlm-python313-v2
FLEET_LLM_API_KEY=

# DSPy model roles.
FLEET_ROOT_MODEL=openai/gpt-4o-mini
FLEET_SUB_MODEL=openai/gpt-4o-mini
FLEET_LLM_BASE_URL=
FLEET_LLM_MAX_TOKENS=

# Daytona Workspace Volume Scope.
FLEET_VOLUME_NAME=rlm-volume-dspy
FLEET_VOLUME_MOUNT_PATH=/home/daytona/fleet

# Files and bounded sizes.
FLEET_MAX_UPLOAD_BYTES=10485760
FLEET_MAX_ARTIFACT_BYTES=10485760
FLEET_RLM_MAX_ITERATIONS=20
FLEET_RLM_MAX_LLM_CALLS=50
FLEET_RLM_MAX_OUTPUT_CHARS=10000
FLEET_TURN_TIMEOUT_SECONDS=900
FLEET_MAX_ACTIVE_DAYTONA_LEASES=8
FLEET_RUN_HEARTBEAT_SECONDS=10
FLEET_RUN_STALE_AFTER_SECONDS=60
