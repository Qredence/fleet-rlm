# Fleet RLM Lite settings. Copy to .env and replace placeholders locally.
# Never commit real passwords, tokens, or provider credentials.

# PostgreSQL for Session history and the virtual filesystem. The database must
# exist already; Fleet creates only its own tables.
FLEET_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fleet

# One warm Daytona sandbox per Session, mounted on its private Volume subpath.
FLEET_DAYTONA_API_KEY=
FLEET_DAYTONA_ORG_ID=
FLEET_DAYTONA_VOLUME_ID=
FLEET_DAYTONA_SNAPSHOT=fleet-rlm-base
FLEET_DAYTONA_AUTO_STOP_MINUTES=30

# DSPy runtime model roles require the native engine's `openai/<service-id>`
# route; Fleet never falls back to LiteLLM. Provide DATABRICKS_TOKEN plus
# either FLEET_LLM_BASE_URL or DATABRICKS_HOST for Unity Gateway. Its default
# base URL derived from DATABRICKS_HOST is /ai-gateway/mlflow/v1.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
FLEET_LLM_BASE_URL=
FLEET_ROOT_MODEL=openai/system.ai.deepseek-v4-1-flash
FLEET_SUB_MODEL=openai/system.ai.claude-haiku-5-5
FLEET_REFLECTION_MODEL=openai/system.ai.claude-sonnet-5-5
FLEET_JUDGE_MODEL=databricks:/databricks-claude-sonnet-5.5
FLEET_TYPESAFE_MODEL=jev-1.14.0
FLEET_TYPESAFE_API_KEY=

# Runtime limits and local state directories.
FLEET_EXECUTION_MODE=hybrid
FLEET_MAX_LLM_CALLS_PER_TURN=150
FLEET_MAX_AGENT_DEPTH=3
FLEET_MAX_CHILD_SANDBOXES=8
FLEET_MAX_ACTIVE_CHILDREN=4
FLEET_TURN_TIMEOUT_SECONDS=900
FLEET_LINKED_CHILDREN=true
FLEET_MAX_ACTIVE_SESSIONS=64
FLEET_MAX_UPLOAD_BYTES=25000000
FLEET_COMPILED_PROGRAM_DIR=.fleet/compiled
FLEET_LOCAL_SKILLS_DIR=.fleet/skills

# MLflow defaults to local SQLite. For Databricks, set the tracking URI,
# absolute workspace experiment path, and all Unity Catalog trace settings.
FLEET_MLFLOW_TRACKING_URI=sqlite:///mlflow.db
FLEET_MLFLOW_EXPERIMENT_NAME=fleet-rlm-production
FLEET_MLFLOW_TRACE_CATALOG=
FLEET_MLFLOW_TRACE_SCHEMA=
FLEET_MLFLOW_TRACE_TABLE_PREFIX=
FLEET_MLFLOW_TRACING_SQL_WAREHOUSE_ID=

# The API is unauthenticated and binds to loopback by default. Setting the
# override permits a non-loopback listener but does not add authentication.
FLEET_HOST=127.0.0.1
FLEET_PORT=8000
FLEET_ALLOW_NON_LOOPBACK_BIND=false
