# Credentials and deployment overrides for Fleet. Never commit real secrets.
# Copy config/fleet.toml.example to the ignored config/fleet.toml (schema_version=5).
# Precedence: defaults < TOML < .env < process environment < explicit overrides.
# FLEET_CONFIG selects a different TOML file through PROCESS environment only.

FLEET_DATABASE_URL=postgresql://<role>:<password>@<direct-host>.neon.tech/<database>?sslmode=require
FLEET_DAYTONA_API_KEY=
FLEET_TYPESAFE_API_KEY=
# Host-side search keys for the sandbox web_search builtin; they never enter the sandbox.
SERPER_API_KEY=
YOU_API_KEY=

# Infrastructure identifiers may instead be placed in TOML.
# FLEET_DAYTONA_ORG_ID=
# FLEET_DAYTONA_VOLUME_ID=
# Configure the default endpoint with [llm].api_base in config/fleet.toml (schema 5).
# Set role-specific api_base values in [llm.root], [llm.sub], and [llm.reflection].

# Root/sub default to openai/system.ai.deepseek-v4-1-flash-1017.
# An explicit shared model overrides roles without their own model.
# Endpoint and explicit key are optional.
# FLEET_LLM_MODEL=openai/gpt-4o-mini
# FLEET_LLM_BASE_URL=https://your-compatible-endpoint.example/v1
# Native DSPy structured output policy; json_object requires the json adapter.
# FLEET_LLM_ADAPTER=chat
# FLEET_LLM_RESPONSE_FORMAT=auto
# FLEET_ROOT_ADAPTER=json
# FLEET_ROOT_RESPONSE_FORMAT=json_object
# FLEET_SUB_ADAPTER=json
# FLEET_SUB_RESPONSE_FORMAT=json_object
FLEET_LLM_API_KEY=
# Native provider credentials may instead be exported in the process environment.
# Advanced role model, endpoint and credential-reference overrides belong in TOML.
# FLEET_ROOT_MAX_TOKENS=16384
# FLEET_SUB_MAX_TOKENS=8192
# These token limits are tuning candidates, NOT validated defaults.
# FLEET_ROOT_TEMPERATURE=0
# FLEET_ROOT_NUM_RETRIES=3
# FLEET_ROOT_CACHE=false
# Equivalent SUB and REFLECTION generation overrides are supported.
# FLEET_TYPESAFE_MODEL=jev-1.14.0
# FLEET_EXECUTION_MODE=hybrid
# 0 or 10..3600; 0 disables the Fleet Turn deadline (provider TTL still applies).
# FLEET_TURN_TIMEOUT_SECONDS=0

# MLflow backend is selected by the command, never by .env.
# FLEET_MLFLOW_LOCAL_PORT=5001
# FLEET_MLFLOW_LOCAL_DATA_DIR=.fleet/mlflow
# FLEET_MLFLOW_LOCAL_EXPERIMENT_NAME=fleet-rlm-dev
# FLEET_MLFLOW_LOCAL_EVAL_EXPERIMENT_NAME=fleet-rlm-eval
# FLEET_MLFLOW_LOCAL_OPTIMIZATION_EXPERIMENT_NAME=fleet-rlm-gepa
# Encryption passphrase and KEK version for local MLflow Gateway secrets stored in mlflow.db.
# Forwarded to the local MLflow server managed by `fleet cli`/`fleet web`; set both if you rotated KEKs.
# MLFLOW_CRYPTO_KEK_PASSPHRASE=
# MLFLOW_CRYPTO_KEK_VERSION=1
# MLflow diagnostic judges use their provider credentials independently of Fleet inference.
# FLEET_JUDGE_MODEL=openai:/system.ai.deepseek-v4-1-flash
# FLEET_HOST=127.0.0.1
# FLEET_PORT=8000
# FLEET_ALLOW_NON_LOOPBACK_BIND=false

# Private published file storage (host only)
# FLEET_STORAGE_ENDPOINT=https://<branch>.storage.<cell>.eu-central-1.aws.neon.tech
# FLEET_STORAGE_REGION=eu-central-1
# FLEET_STORAGE_BUCKET=fleet-files
# FLEET_STORAGE_ACCESS_KEY=
# FLEET_STORAGE_SECRET_KEY=
# Optional PostgreSQL/S3 backend for the locally running MLflow server
# FLEET_MLFLOW_LOCAL_BACKEND_STORE_URI=postgresql+psycopg://<role>:<password>@<direct-host>/mlflow?sslmode=require
# FLEET_MLFLOW_LOCAL_ARTIFACT_DESTINATION=s3://mlflow-artifacts
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-central-1
# MLFLOW_S3_ENDPOINT_URL=https://<branch>.storage.<cell>.eu-central-1.aws.neon.tech
