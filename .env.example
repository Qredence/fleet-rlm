# fleet-rlm Environment Configuration
#
# Copy this file to .env and fill in your own values.
# The .env file is gitignored for security—never commit secrets!
#
# REQUIRED: LLM Configuration (one of the two API key formats below)
#
# The LLM model to use for the planner (DSPy's reasoning engine)
# Examples:
#   - Google: "google/gemini-3-flash-preview"
#   - OpenAI: "openai/gpt-5.2
#   - Anthropic: "anthropic/claude-3-sonnet"
#   - Use a LiteLLM proxy: "openai/your-proxy-endpoint"
DSPY_LM_MODEL=

# API key for the LLM provider (if using standard OpenAI-compatible endpoint)
# Or use DSPY_LM_API_KEY below as an alternative
DSPY_LLM_API_KEY=sk-...

# Alternative API key name (some providers use this instead)
# Uncomment and use if DSPY_LLM_API_KEY doesn't work for your provider
# DSPY_LM_API_KEY=sk-...

#
# OPTIONAL: Neon Postgres + Auth (for API server persistence)
#

# Pooled Neon PostgreSQL URL used by the application runtime
# Optional for local dev: when unset or unreachable, the server gracefully
# degrades to SQLite-only local persistence (no data loss for chat/sessions).
# Example:
# DATABASE_URL=postgresql://user:password@ep-foo-bar-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=

# Direct Neon PostgreSQL URL used for Alembic, schema management, and admin/debug tasks
# Example:
# DATABASE_ADMIN_URL=postgresql://user:password@ep-foo-bar.us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_ADMIN_URL=

# Runtime environment guardrails:
# - local: developer defaults (debug auth enabled, retired SQLite routes enabled)
# - staging/production: strict auth + Neon persistence defaults
APP_ENV=local

# Require auth on API/WS routes:
# - false (default in dev): auth is optional; server falls back to anonymous identity
# - true: missing/invalid auth is rejected
AUTH_REQUIRED=false

# Neon Auth inputs
# NEON_AUTH_URL is hardcoded by default in config.py (fleet-rlm project, eu-central-1).
# Override only if you fork and provision your own Neon Auth branch.
# NEON_AUTH_URL=https://ep-xxx.neonauth.../neondb/auth
# Optional single-tenant admission claim; defaults to "default".
# NEON_TENANT_CLAIM=default
# DATABASE_REQUIRED defaults to true.
# FLEET_SECRET_ENCRYPTION_KEY — Fernet key used to encrypt hosted BYOK provider
# profile API keys and per-workspace Daytona credentials at rest. REQUIRED for
# staging/production AUTH_MODE=neon BYOK. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FLEET_SECRET_ENCRYPTION_KEY=

# Frontend SPA auth: Neon Auth URL is hardcoded in src/frontend/src/lib/auth/neon.ts.
# No VITE_NEON_AUTH_URL env var needed.
# Set only providers enabled in Neon Auth; defaults to google for local development.
# VITE_NEON_AUTH_SOCIAL_PROVIDERS=google

# CORS allowed origins (required in non-local deployments; defaults to [] if unset)
# CORS_ALLOWED_ORIGINS=https://fleet-rlm.fastapicloud.dev

# Require Neon repository at runtime. Defaults true in staging/production.
# DATABASE_REQUIRED=true

# Legacy SQLite routes (/api/v1/tasks, /api/v1/sessions CRUD) gate.
# Defaults true only in local APP_ENV.
# LEGACY_SQLITE_ROUTES_ENABLED=true

# Debug auth controls (dev mode only). Defaults true only in local APP_ENV.
# ALLOW_DEBUG_AUTH=true
# ALLOW_QUERY_AUTH_TOKENS=true

# CORS origin allowlist (comma-separated). Defaults "*" in local APP_ENV.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com

# WS execution stream backpressure settings.
# WS_EXECUTION_MAX_QUEUE=256
# WS_EXECUTION_DROP_POLICY=drop_oldest

#
# OPTIONAL: Recursive RLM isolation
#

# Child RLM isolation policy:
# - auto: fork no-volume parents; use clean child sandboxes with volume subpaths
#         when a durable Daytona volume is mounted.
# - context: context-mode same-sandbox fresh-context behavior for local debugging.
# RLM_CHILD_ISOLATION_MODE=auto

# No-volume fork failure policy:
# - clean: retry a clean child sandbox
# - fail: return a structured isolation failure
# RLM_CHILD_FORK_FALLBACK=clean

# Delegate child responsiveness. Keep this lower than the sandbox lifetime so
# broker/startup failures return as degraded/error results instead of stalling
# the full sandbox timeout.
# RLM_DELEGATE_EXECUTION_TIMEOUT=120
# DAYTONA_BROKER_HEALTH_TIMEOUT=20.0
# DAYTONA_BROKER_START_RETRIES=1

#
# OPTIONAL: LLM Endpoint and Parameters
#

# Custom API endpoint (if using LiteLLM proxy or self-hosted model)
# Default: OpenAI-compatible endpoint
# Example: "https://api.together.ai/v1"
# DSPY_LM_API_BASE=https://your-litellm-proxy.com

# Optional explicit provider hint passed to litellm as ``custom_llm_provider``.
# Leave unset to let litellm auto-detect the provider from the model id
# (recommended for non-OpenAI endpoints like Anthropic). Set to ``openai`` when
# pointing a bare model id at an OpenAI-compatible api_base.
# DSPY_LM_CUSTOM_PROVIDER=openai
# DSPY_DELEGATE_LM_CUSTOM_PROVIDER=openai

# Maximum tokens for LLM response
# Default: 8192
# Increase for longer outputs, decrease to save tokens
# DSPY_LM_MAX_TOKENS=65536

#
# OPTIONAL: Daytona Experimental Pilot
#

# Native Daytona credentials for the experimental `fleet-rlm daytona-smoke`
# and `fleet-rlm daytona-rlm` commands.
# Use DAYTONA_API_URL for Daytona API routing.
# DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api
# Optional Daytona target/cluster selector.
# DAYTONA_TARGET=

#
# OPTIONAL: PostHog LLM Analytics
#

# Enable PostHog analytics callback for DSPy LM calls.
# If POSTHOG_ENABLED is unset, runtime defaults to enabled when a project-owned
# default key (or explicit POSTHOG_API_KEY) is available.
POSTHOG_ENABLED=false

# PostHog project API key (explicit override). If omitted, runtime may use a
# project-owned default key when configured in source for web/server telemetry.
# POSTHOG_API_KEY=phc_...

# PostHog host (defaults to project canonical host if unset; explicit override supported)
POSTHOG_HOST=https://eu.i.posthog.com

# Optional explicit distinct id (runtime identity takes precedence when available)
# POSTHOG_DISTINCT_ID=anonymous

# Flush cadence for batched analytics events
POSTHOG_FLUSH_INTERVAL=10.0
POSTHOG_FLUSH_AT=10

# Track optimizer traffic (disabled by default to preserve deterministic training workflows)
POSTHOG_ENABLE_DSPY_OPTIMIZATION=false

# Payload capture controls
POSTHOG_INPUT_TRUNCATION=10000
POSTHOG_OUTPUT_TRUNCATION=5000
POSTHOG_REDACT_SENSITIVE=true

#
# OPTIONAL: MLflow Tracing, Feedback, Evaluation, and Optimization
#

# Enable first-class MLflow tracing for DSPy/module execution.
# Set to false to disable MLflow integration entirely.
MLFLOW_ENABLED=true

# Local OSS default. You can also point this at a remote/self-hosted MLflow server.
MLFLOW_TRACKING_URI=http://127.0.0.1:5001

# Backend store used by the local auto-started OSS server and `make mlflow-server`.
# Leave this at the default SQLite file for local development unless you need a
# different store URI.
# MLFLOW_LOCAL_BACKEND_STORE_URI=sqlite:///.data/mlruns.db

# Auto-start the local MLflow server during `uv run fleet web` / `serve-api`
# when APP_ENV=local and MLFLOW_TRACKING_URI points at localhost. Leave unset
# to use that local-default behavior, or set this to false to manage MLflow
# manually with `make mlflow-server` instead.
# MLFLOW_AUTO_START=false

# Protected remote MLflow servers can use either a bearer token or basic auth.
# Uncomment the option your tracking server expects.
# MLFLOW_TRACKING_TOKEN=replace-with-token
# MLFLOW_TRACKING_USERNAME=replace-with-username
# MLFLOW_TRACKING_PASSWORD=replace-with-password

# Optional TLS override for development against self-signed certs only.
# MLFLOW_TRACKING_INSECURE_TLS=false

# Experiment used for live traces, feedback, offline evaluation, and optimization runs.
MLFLOW_EXPERIMENT=fleet-rlm

# Optional model id to associate with traces/evaluation runs.
# MLFLOW_ACTIVE_MODEL_ID=model-123

# If local startup logs mention an out-of-date MLflow schema, run:
# uv run mlflow db upgrade sqlite:///.data/mlruns.db
# Or remove the local SQLite file if the tracking history is disposable.

# Encryption passphrase for secrets stored by MLflow (e.g., tracking credentials).
# Required for any shared or remote tracking server. For local dev, set a random
# value to silence the security warning. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# MLFLOW_CRYPTO_KEK_PASSPHRASE=replace-with-random-passphrase

# Span processors (metadata enrichment on every span)
# MLFLOW_ENABLE_SPAN_PROCESSORS=true

# Auto-assessment (production scorer registration)
# FLEET_RLM_ENABLE_AUTO_ASSESSMENT=false
# FLEET_RLM_AUTO_ASSESSMENT_SCORERS=safety,guidelines
# Explicit judge model for scheduled MLflow scorers. Set this to a valid
# LiteLLM/OpenAI-compatible model instead of relying on an MLflow default
# gateway endpoint that may not exist in the tracking server.
# FLEET_RLM_AUTO_ASSESSMENT_JUDGE_MODEL=openai/gemini-3-flash-preview
# FLEET_RLM_AUTO_ASSESSMENT_SAMPLE_RATE=1.0

# DSPy autologging controls for compile/eval flows.
MLFLOW_DSPY_LOG_TRACES_FROM_COMPILE=false
MLFLOW_DSPY_LOG_TRACES_FROM_EVAL=true
MLFLOW_DSPY_LOG_COMPILES=false
MLFLOW_DSPY_LOG_EVALS=

#
# NOTES:
# - Daytona credentials are per-user: set DAYTONA_API_KEY and DAYTONA_API_URL
# - LM credentials are configured via DSPY_LM_MODEL and DSPY_LLM_API_KEY / DSPY_LM_API_KEY
# - Never commit this file once filled with real secrets
# - For team setups, use your secret manager instead of .env
#

#
# OPTIONAL: Brave Search API
#
# Set either key to enable Brave-backed web_search. Leave both blank to keep
# web_search disabled until provider credentials are configured.
#
BRAVE_SEARCH_API_KEY=
BRAVE_API_KEY=
