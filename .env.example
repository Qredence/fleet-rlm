# Fleet RLM backend

# Offline/hermetic is the default. Enable live composition explicitly.
FLEET_LIVE_KERNEL=false
FLEET_APP_NAME=fleet-rlm

# Required for live composition.
FLEET_DATABASE_URL=postgresql+asyncpg://user:password@host/database
FLEET_DAYTONA_API_KEY=
FLEET_LLM_API_KEY=

# DSPy model roles.
FLEET_ROOT_MODEL=openai/gpt-4o-mini
FLEET_SUB_MODEL=openai/gpt-4o-mini
FLEET_LLM_BASE_URL=
FLEET_LLM_MAX_TOKENS=

# Daytona Workspace Volume Scope.
FLEET_VOLUME_NAME=rlm-volume-dspy
FLEET_VOLUME_MOUNT_PATH=/home/daytona/fleet

# Files and bounded sizes. Host roots are offline-only.
FLEET_UPLOAD_ROOT=
FLEET_ARTIFACT_ROOT=
FLEET_MAX_UPLOAD_BYTES=10485760
FLEET_MAX_ARTIFACT_BYTES=10485760

# Authentication: dev permits synthetic X-Fleet-* headers; neon requires JWT.
FLEET_AUTH_MODE=dev
FLEET_NEON_AUTH_URL=
FLEET_NEON_TENANT_CLAIM=
