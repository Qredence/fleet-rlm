# Fleet RLM values explicitly referenced by config/fleet.toml. Non-secret
# runtime policy — including the active profile — lives in TOML
# ([config] default_profile); profile changes require a process restart.
# FLEET_CONFIG_PROFILE is no longer consulted.

# The committed daytona-recursive profile routes Root and Sub through the
# Modal-hosted GLM Chat Completions endpoint. To use another OpenAI-compatible
# provider, update the profile's api_key_env and base_url_env in
# config/fleet.toml. Process exports win over this file.
#   FLEET_MODAL_BASE_URL=https://<modal-endpoint>.modal.direct/v1
FLEET_MODAL_API_KEY=
FLEET_MODAL_BASE_URL=
FLEET_DAYTONA_API_KEY=
# Durable deployment: point FLEET_DATABASE_URL at Alembic-head Postgres;
# local SQLite is suitable for development. Never commit a real password.
# Provisioning runbook: docs/how-to-guides/lakebase-postgres.md
#   FLEET_DATABASE_URL=postgresql://fleet_app:<password>@<lakebase-host>:5432/fleet_rlm?sslmode=require
FLEET_DATABASE_URL=sqlite+aiosqlite:///./.fleet_rlm/local.sqlite3

# Databricks MLflow and evaluation lanes authenticate with DATABRICKS_HOST and
# DATABRICKS_TOKEN (or databricks-cli). These are unrelated to the Root/Sub
# Chat Completion credentials above.
# DATABRICKS_HOST=https://<workspace-host>
DATABRICKS_TOKEN=

# Optional Databricks MLflow trace destinations. Consumed only when a local
# profile declares the corresponding mlflow.*_env references in
# config/fleet.toml (the committed profiles do not).
FLEET_MLFLOW_EXPERIMENT_NAME=
FLEET_MLFLOW_TRACE_CATALOG=
FLEET_MLFLOW_TRACE_SCHEMA=
FLEET_MLFLOW_TRACE_TABLE_PREFIX=
FLEET_MLFLOW_TRACING_SQL_WAREHOUSE_ID=

# Optional custom Root/Sub base URL for an OpenAI-compatible Databricks AI
# Gateway. Consumed only when a local profile declares it as base_url_env.
# GCP example: https://<workspace-id>.ai-gateway.gcp.databricks.com/mlflow/v1
FLEET_DATABRICKS_AI_GATEWAY_BASE_URL=

# Optional PostHog product analytics token referenced by the committed policy.
POSTHOG_PROJECT_TOKEN=
