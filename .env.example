# Fleet RLM secrets and durable deployment overrides.
# Non-secret runtime policy lives in config/fleet.toml. Select its required
# profile explicitly; profile changes require a process restart.
FLEET_CONFIG_PROFILE=daytona

# Deno requires the configured role key(s) and may use local SQLite. Daytona
# additionally requires the database URL and Daytona key. Keep secrets here or
# in process-level secret injection; never put secret values in fleet.toml.
FLEET_DATABASE_URL=sqlite+aiosqlite:///./.fleet_rlm/local.sqlite3
FLEET_DAYTONA_API_KEY=
FLEET_LLM_API_KEY=

# Existing FLEET_* policy values remain supported as higher-precedence
# deployment/CI overrides, for example:
# FLEET_ROOT_MODEL=openai/gpt-4o-mini
# FLEET_RLM_MAX_ITERATIONS=20
