# Fleet RLM values explicitly referenced by config/fleet.toml. Non-secret
# runtime policy — including the active profile — lives in TOML
# ([config] default_profile); profile changes require a process restart.
# FLEET_CONFIG_PROFILE is no longer consulted.

# Durable deployment: point FLEET_DATABASE_URL at Alembic-head Postgres;
# local SQLite is suitable for development. Never commit a real password.
# Provisioning runbook: docs/how-to-guides/lakebase-postgres.md
#   FLEET_DATABASE_URL=postgresql://fleet_app:<password>@<lakebase-host>:5432/fleet_rlm?sslmode=require
FLEET_DATABASE_URL=sqlite+aiosqlite:///./.fleet_rlm/local.sqlite3
FLEET_DAYTONA_API_KEY=
# Daytona organization routing; the settings loader rejects .env/process drift.
FLEET_DAYTONA_ORG_ID=

# The default daytona-native and opt-in daytona-recursive profiles route Root
# and Sub through the Alibaba DashScope (MaaS) OpenAI-compatible endpoint. The
# base URL must be the /compatible-mode/v1 root; /chat/completions is appended
# by the client. Process exports win for provider values.
ALIBABA_API_KEY=
FLEET_MAAS_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# The daytona-managed profile uses the Databricks Unity AI Gateway MLflow
# Chat Completions endpoint instead. The base URL must include
# /ai-gateway/mlflow/v1; /chat/completions is appended by the client.
DATABRICKS_TOKEN=
FLEET_LLM_BASE_URL=https://<workspace-host>/ai-gateway/mlflow/v1

# Databricks MLflow and evaluation tooling authenticate with DATABRICKS_HOST
# and DATABRICKS_TOKEN (or databricks-cli). DATABRICKS_HOST is the workspace
# root and is not the Fleet Root/Sub Chat Completions base URL.
# DATABRICKS_HOST=https://<workspace-host>

# Optional Databricks MLflow trace destinations. Profile-driven application
# tracing consumes these when a local profile declares the corresponding
# mlflow.*_env references in config/fleet.toml; benchmark scripts also read
# them directly (for example scripts/benchmarks/run_rlm_latency.py and the
# MLflow management/evaluation scripts).
FLEET_MLFLOW_EXPERIMENT_NAME=
FLEET_MLFLOW_TRACE_CATALOG=
FLEET_MLFLOW_TRACE_SCHEMA=
FLEET_MLFLOW_TRACE_TABLE_PREFIX=
FLEET_MLFLOW_TRACING_SQL_WAREHOUSE_ID=

# Optional custom OpenAI-compatible Databricks AI Gateway base URL for
# benchmark/provider-specific policies. The committed profile uses
# FLEET_LLM_BASE_URL instead; scripts/benchmarks/run_rlm_latency.py also reads
# this variable directly.
# GCP example: https://<workspace-id>.ai-gateway.gcp.databricks.com/openai/v1
FLEET_DATABRICKS_AI_GATEWAY_BASE_URL=

# Optional PostHog product analytics token referenced by the committed policy.
POSTHOG_PROJECT_TOKEN=
