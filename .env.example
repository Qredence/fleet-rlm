# Credentials and deployment overrides for Fleet. Never commit real secrets.
# Non-secret defaults live in config/fleet.toml (schema_version=4).
# Precedence: defaults < TOML < .env < process environment < explicit overrides.
# FLEET_CONFIG selects a different TOML file through PROCESS environment only.

FLEET_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fleet
DATABRICKS_TOKEN=
FLEET_DAYTONA_API_KEY=
FLEET_TYPESAFE_API_KEY=

# Infrastructure identifiers may instead be placed in TOML.
# DATABRICKS_HOST=
# FLEET_DAYTONA_ORG_ID=
# FLEET_DAYTONA_VOLUME_ID=
# FLEET_LLM_BASE_URL=https://<workspace>/ai-gateway/mlflow/v1
# FLEET_DAYTONA_SNAPSHOT=fleet-rlm-base

# Optional deployment overrides. Omit them to use TOML/defaults.
# FLEET_ROOT_MODEL=openai/<verified-service>
# FLEET_SUB_MODEL=openai/<verified-service>
# FLEET_REFLECTION_MODEL=openai/<verified-service>
# FLEET_ROOT_MAX_TOKENS=16384
# FLEET_SUB_MAX_TOKENS=8192
# These token limits are tuning candidates, NOT validated defaults.
# FLEET_ROOT_TEMPERATURE=0
# FLEET_ROOT_NUM_RETRIES=3
# FLEET_ROOT_CACHE=false
# Equivalent SUB and REFLECTION generation overrides are supported.
# FLEET_TYPESAFE_MODEL=jev-1.14.0
# FLEET_EXECUTION_MODE=hybrid
# FLEET_TURN_TIMEOUT_SECONDS=900
# Minutes a stopped root sandbox is kept before Daytona deletes it (-1 = never; 0 is refused).
# A deleted root is rebuilt from the snapshot; Session state lives on the Volume.
# FLEET_DAYTONA_ROOT_AUTO_DELETE_MINUTES=10080

# MLflow backend is selected by the command, never by .env.
# `fleet cli` manages local MLflow; `fleet cli databricks` selects Databricks.
# FLEET_MLFLOW_LOCAL_PORT=5001
# FLEET_MLFLOW_LOCAL_DATA_DIR=.fleet/mlflow
# FLEET_MLFLOW_LOCAL_EXPERIMENT_NAME=fleet-rlm-dev
# FLEET_MLFLOW_LOCAL_EVAL_EXPERIMENT_NAME=fleet-rlm-eval
# FLEET_MLFLOW_LOCAL_OPTIMIZATION_EXPERIMENT_NAME=fleet-rlm-gepa
# FLEET_MLFLOW_DATABRICKS_TRACKING_URI=databricks
# FLEET_MLFLOW_DATABRICKS_EXPERIMENT_NAME=/Shared/fleet-rlm-runtime
# FLEET_MLFLOW_DATABRICKS_EVAL_EXPERIMENT_NAME=/Shared/fleet-rlm-eval
# FLEET_MLFLOW_DATABRICKS_OPTIMIZATION_EXPERIMENT_NAME=/Shared/fleet-rlm-gepa
# FLEET_MLFLOW_DATABRICKS_TRACE_CATALOG=uscentral
# FLEET_MLFLOW_DATABRICKS_TRACE_SCHEMA=fleet_observability
# FLEET_MLFLOW_DATABRICKS_TRACE_TABLE_PREFIX=fleet_rlm_runtime
# FLEET_MLFLOW_DATABRICKS_TRACING_SQL_WAREHOUSE_ID=<warehouse-id>
# FLEET_MLFLOW_DATABRICKS_EVAL_TRACE_TABLE_PREFIX=fleet_rlm_eval
# FLEET_MLFLOW_DATABRICKS_OPTIMIZATION_TRACE_SCHEMA=fleet_gepa
# FLEET_MLFLOW_DATABRICKS_OPTIMIZATION_TRACE_TABLE_PREFIX=fleet_rlm_gepa
# openai:/ judges route through the AI Gateway with DATABRICKS_TOKEN.
# FLEET_JUDGE_MODEL=openai:/system.ai.deepseek-v4-1-flash
# FLEET_HOST=127.0.0.1
# FLEET_PORT=8000
# FLEET_ALLOW_NON_LOOPBACK_BIND=false

# Sandbox network policy (enforced per sandbox on Daytona Tier 3/4 only). Egress is blocked by default:
# LM calls and host tools use the host bridge, and packages must be baked into the snapshot (PyPI is blocked).
# A non-empty comma-separated allow list (e.g. "example.com,*.example.org") replaces block-all.
# FLEET_DAYTONA_NETWORK_BLOCK_ALL=true
# FLEET_DAYTONA_DOMAIN_ALLOW_LIST=
