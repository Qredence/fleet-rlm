# Copy to backend/.env. Use a Neon Postgres 18 branch and its two endpoints.
FLEET_DATABASE_URL=postgresql+psycopg://user:password@ep-example-pooler.region.aws.neon.tech/fleet?sslmode=require
FLEET_DATABASE_DIRECT_URL=postgresql+psycopg://user:password@ep-example.region.aws.neon.tech/fleet?sslmode=require
# FLEET_DB_POOL_SIZE=2
# FLEET_DB_MAX_OVERFLOW=5
# FLEET_DB_POOL_RECYCLE_SECONDS=300

# FLEET_API_BEARER_TOKEN=
# FLEET_CORS_ORIGINS=["http://localhost:5173"]
# FLEET_MAX_CONCURRENT_TURNS_PER_WORKER=16
# FLEET_STALE_RUN_TIMEOUT_SECONDS=900

FLEET_DAYTONA_API_KEY=
# Optional host-side credential for optimization dataset volumes and their helper sandboxes.
DAYTONA_API_SERVICE_KEY=
# Use the registered img_ ID from the sandbox image build for deployments.
FLEET_DAYTONA_IMAGE=fleet-rlm-py313-dspy35-v2
# FLEET_DAYTONA_REGION=
# FLEET_DAYTONA_IDLE_TIMEOUT_MINUTES=15
# FLEET_DAYTONA_MAX_LIFETIME_MINUTES=480
# FLEET_DAYTONA_NETWORK_ALLOW_DOMAINS=[]
# FLEET_DAYTONA_OPTIMIZE_SPOT=false
# FLEET_DAYTONA_OTEL_ENABLED=false
# Set MLFLOW_USE_DEFAULT_TRACER_PROVIDER=false with Daytona OTel enabled to share MLflow's trace.
# MLFLOW_USE_DEFAULT_TRACER_PROVIDER=false
# FLEET_DAYTONA_EXEC_TIMEOUT_SECONDS=120

FLEET_S3_BUCKET=fleet-workspaces
FLEET_S3_ENDPOINT_URL=
FLEET_S3_REGION=eu-central-1
FLEET_S3_ACCESS_KEY_ID=
FLEET_S3_SECRET_ACCESS_KEY=

FLEET_LLM_MODEL=
FLEET_SUB_LLM_MODEL=
FLEET_LLM_API_KEY=
# FLEET_LLM_BASE_URL=
# FLEET_DECISION_MODEL=typesafe:jev-latest
# TYPESAFE_API_KEY=
# Pin the exact TypeSafe Jev snapshot in FLEET_DECISION_MODEL when using ReAnchor artifacts.

# FLEET_RLM_MAX_ITERS=20
# FLEET_RLM_MAX_LLM_CALLS=50
# FLEET_RLM_MAX_OUTPUT_CHARS=10000
# FLEET_RLM_MAX_DEPTH=4
# FLEET_HISTORY_MAX_TURNS=8
# FLEET_HISTORY_MAX_CHARS=16000

# FLEET_SKILLS_DIR=skills
# FLEET_OPTIMIZED_PROGRAM_PATH=
# FLEET_SKILL_SELECTOR_PATH=
# FLEET_MEMORY_GATE_PATH=

# FLEET_MLFLOW_TRACKING_URI=http://127.0.0.1:5001
# FLEET_MLFLOW_EXPERIMENT=fleet-rlm

# Optional host-only credential for the web-research skill
TAVILY_API_KEY=

# Provider registry encryption. Use a generated Fernet key or a secret passphrase
# of at least 16 characters. Keep a backup of the value with your database backup.
# If you used a passphrase on the pre-release branch, re-enter stored provider
# API keys after upgrading. Existing generated Fernet keys remain compatible.
# FLEET_CREDENTIALS_ENCRYPTION_KEY=
