# Fleet RLM - Daytona Sandbox Lifecycle & Admission Control

digraph FleetRLM_DaytonaLifecycle {
    label="Daytona Sandbox Lifecycle & Interpreter Lease Management";
    labelloc="t";
    fontsize=16;
    
    // Styling
    node [shape=box, style=filled];
    edge [fontsize=12];
    
    // State machine nodes
    state_created [label="Created\nprovisioner.create()\nSnapshot + Volume mount", fillcolor=lightblue, style=filled];
    state_started [label="Started\nprovisioner.start()\nSandbox running", fillcolor=palegreen, style=filled];
    state_running [label="Running\nReady check passed\nVolume mounted\nWorkspace scoped", fillcolor=lightcyan, style.filled=true];
    state_idle [label="Idle\nInterpreter released\nSandbox retained", fillcolor=lightyellow, style=filled];
    state_interpreting [label="Interpreting\nInterpreter active\nLease held\nMax 8 concurrent", fillcolor=pink, style.filled=true];
    state_stopped [label="Stopped\nSandbox stopped\nVolume persists", fillcolor=silver, style.filled=true];
    
    // Admission control
    subgraph cluster_admission {
        color=darkblue;
        label="Admission Control";
        labeljust=l;
        
        semaphore [label="asyncio.BoundedSemaphore\nmax_active_leases = 8\nDefaultTurnPreparer.semaphore", fillcolor=thistle, style=filled];
        deadline_check [label="Check deadline\nMust compete with acquire()", fillcolor=wheat, style.filled=true];
        permit_acquired [label="Permit acquired\nInterpreter lease ready", fillcolor=mintcream, style.filled=true];
    }
    
    // Provisioning
    subgraph cluster_provisioning {
        color=darkgreen;
        label="Provisioning Phase";
        labeljust=l;
        
        snapshot_load [label="Load Snapshot\ndspy-snapshot-vX.X.X\nPython version from spec", fillcolor=navajowhite, style.filled=true];
        volume_create [label="Create/Reuse Volume\nrlm-volume-dspy\nMount: /home/daytona/fleet", fillcolor=khaki, style.filled=true];
        workspace_scope [label="Scope Workspace\nworkspaces/{workspace_id}\nSubpath mounting", fillcolor=lemonchiffon, style.filled=true];
        resource_limits [label="Resource Limits\n1 CPU\n1 GiB RAM\n3 GiB disk\nEnforced by validation", fillcolor=gainsboro, style.filled=true];
    }
    
    // Lease Management
    subgraph cluster_lease {
        color=crimson;
        label="Lease Management";
        labeljust=l;
        
        lease_acquire [label="InterpreterLease.acquire()\nAcquire admission permit\nGet or create sandbox\nStart if needed", fillcolor=violet, style.filled=true];
        interpreter_setup [label="Create DaytonaCodeInterpreter\nREPL connection\nHTTP broker setup", fillcolor=plum, style.filled=true];
        http_broker [label="HttpToolBroker HTTP server\nHost-tool mediation\nSUBMIT capture", fillcolor=palegoldenrod, style.filled=true];
        lease_release [label="InterpreterLease.release()\nRelease permit only\nInterpreter not deleted", fillcolor=rosybrown, style.filled=true];
    }
    
    // Idle timeout
    subgraph cluster_timeout {
        color=sienna;
        label="Idle Timeout";
        labeljust=l;
        
        idle_timer [label="Start 5-minute timer\nAfter release", fillcolor=burlywood, style.filled=true];
        timer_expired [label="Timer expired\nIdle timeout reached", fillcolor=bisque, style.filled=true];
        stop_decision [label="Stop sandbox\nDelete but keep volume", fillcolor=tan, style.filled=true];
        reuse_decision [label="Reuse existing\nSandbox already running", fillcolor=blanchedalmond, style.filled=true];
    }
    
    // Lifecycle phases
    main_transition [label="Main Transition Flow", fillcolor=white, penwidth=3, style=filled, peripheries=2];
    
    // Edges representing state transitions
    state_created -> state_started [label="start()", penwidth=2]
    state_started -> state_running [label="ready check", penwidth=2]
    state_running -> state_interpreting [label="lease acquired", penwidth=3]
    state_interpreting -> state_idle [label="interpreter released", penwidth=2]
    state_running -> state_stopped [label="stop()", style=dashed]
    state_idle -> state_stopped [label="stop() (timeout)", style=dashed]
    state_stopped -> [*] [label="delete()", style=dashed]
    state_interpreting -> state_interpreting [label="multiple turns\n(lease retained)", constraint=false, style=dashed]
    
    // Admission flow
    deadline_check -> semaphore [label="before"]
    semaphore -> permit_acquired [label="success"]
    semaphore -.-> deadline_check [label="deadline exceeds?", style=dotted]
    permit_acquired -> lease_acquire [label="proceeds"]
    
    // Provisioning details
    snapshot_load -> volume_create [label="then"]
    volume_create -> workspace_scope [label="then"]
    workspace_scope -> resource_limits [label="enforce"]
    resource_limits -> state_created [label="create sandbox"]
    
    // Lease management flow
    lease_acquire -> interpreter_setup [label="then"]
    interpreter_setup -> http_broker [label="bind tools"]
    http_broker -> state_interpreting [label="active"]
    state_interpreting -> lease_release [label="turn complete"]
    lease_release -> idle_timer [label="after"]
    
    // Idle timeout logic
    idle_timer -> timer_expired [label="wait 5 min"]
    timer_expired -> stop_decision [label="then"]
    stop_decision -> state_stopped [label="execute"]
    
    // Reuse decision
    state_running -.-> reuse_decision [label="if exists", style=dotted]
    reuse_decision -.-> state_running [label="fast path", style=dotted]
    
    // Notes and constraints
    note_max_concurrent [label="Note:\nMAX 8 concurrent leases\nDaytonaAdmission enforces this", fillcolor=lightpink, shape=note, style=filled];
    note_volume_persists [label="Note:\nVolume identity persists\nacross sandbox replacement", fillcolor=lightyellow, shape=note, style=filled];
    note_http_broker [label="Note:\nHTTP broker runs inside sandbox\nmediates host tools and SUBMIT", fillcolor=lightcyan, shape=note, style=filled];
    
    // Position notes near relevant sections
    note_max_concurrent -> semaphore
    note_volume_persists -> state_idle
    note_http_broker -> http_broker
    
    // Key operations summary box
    subgraph cluster_summary {
        label="Key Operations Summary";
        bgcolor=transparent;
        orientation=vertical;
        
        op_provision [label="1. Provision\n(sparse, on-demand)"];
        op_acquire [label="2. Acquire lease\n(bounded semaphore)"];
        op_execute [label="3. Execute turn\n(interpreter active)"];
        op_release [label="4. Release lease\n(fast, no delete)"];
        op_timeout [label="5. Timeout cleanup\n(stop after 5 min)"];
    }
    
    // Connection summary to main flow
    op_provision -> state_created [style=dotted]
    op_acquire -> state_interpreting [style=dotted]
    op_execute -> state_interpreting [style=dotted]
    op_release -> state_idle [style=dotted]
    op_timeout -> state_stopped [style=dotted]
}
