{
  "name": "@qredence/hax-fleet",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "src/main.tsx",
    "src/styles/**/*"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "rm -rf dist && vp build && uv run --active python ../../scripts/ensure_frontend_entrypoint.py --dist-dir dist",
    "preview": "vite preview",
    "type-check": "tsc -p tsconfig.app.json --noEmit",
    "type-check:relaxed": "tsc -p tsconfig.app.json --noEmit --strict false --noUnusedLocals false --noUnusedParameters false --noUncheckedIndexedAccess false",
    "lint": "vp lint src/",
    "lint:robustness": "pnpm run lint",
    "lint:style-tokens": "node scripts/check-style-tokens.js",
    "lint:dead-code": "knip",
    "format": "vp fmt src/",
    "format:check": "vp fmt --check src/",
    "test:e2e": "playwright test",
    "test:unit": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "api:sync-spec": "mkdir -p openapi && OPENAPI_SPEC_PATH=\"${OPENAPI_SPEC_PATH:-../../openapi.yaml}\" && cp \"$OPENAPI_SPEC_PATH\" openapi/fleet-rlm.openapi.yaml",
    "api:types": "openapi-typescript openapi/fleet-rlm.openapi.yaml -o src/lib/rlm-api/generated/openapi.ts",
    "api:sync": "pnpm run api:sync-spec && pnpm run api:types && pnpm exec vp check --fix openapi/fleet-rlm.openapi.yaml src/lib/rlm-api/generated/openapi.ts",
    "api:check": "node scripts/check-api-sync.mjs",
    "check": "pnpm run type-check && pnpm run lint && pnpm run lint:style-tokens && pnpm run lint:dead-code && pnpm run test:unit && pnpm run build && pnpm run test:e2e"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@hugeicons/core-free-icons": "4.2.1",
    "@hugeicons/react": "1.1.7",
    "@neondatabase/auth-ui": "0.2.1-beta",
    "@neondatabase/neon-js": "0.6.2-beta",
    "@pierre/diffs": "^1.2.11",
    "@posthog/react": "1.10.2",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "@tanstack/router-plugin": "^1.168.18",
    "@visual-json/react": "^0.4.0",
    "@xyflow/react": "^12.11.0",
    "agentation": "^3.0.2",
    "ai": "^6.0.208",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.40.0",
    "nanoid": "^5.1.14",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "posthog-js": "1.390.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "4.11.2",
    "shiki": "3.23.0",
    "sonner": "2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "4.3.1",
    "@tanstack/react-router-devtools": "1.167.0",
    "@types/bun": "1.3.14",
    "@types/node": "24.7.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "4.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.6.0",
    "jscpd": "^4.2.5",
    "jsdom": "^26.1.0",
    "knip": "^6.17.1",
    "openapi-typescript": "^6.7.6",
    "prettier": "^3.8.4",
    "shadcn": "^4.11.0",
    "tailwindcss": "4.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.61.1",
    "vite": "^8.0.16",
    "vite-plus": "^0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.24"
  },
  "packageManager": "pnpm@11.8.0"
}
