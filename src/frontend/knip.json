{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/router.tsx",
    "src/client.tsx",
    "src/server.ts",
    "src/**/__tests__/**/*.test.{ts,tsx}",
    "src/**/*.test.{ts,tsx}"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreBinaries": ["uv"],
  "ignoreUnresolved": ["/src/.*"],
  "ignoreDependencies": [
    "globals",
    "prettier",
    "@eslint/js",
    "eslint-plugin-react-hooks",
    "eslint-plugin-react-refresh",
    "tailwindcss",
    "typescript-eslint",
    "tw-animate-css",
    "@fontsource-variable/inter",
    "@streamdown/cjk",
    "@streamdown/math",
    "@streamdown/mermaid",
    "@tanstack/router-plugin",
    "embla-carousel-react",
    "jscpd",
    "nanoid",
    "next-themes",
    "shadcn",
    "use-stick-to-bottom"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "includeEntryExports": false,
  "rules": {
    "exports": "warn",
    "nsExports": "warn",
    "types": "warn",
    "nsTypes": "warn",
    "enumMembers": "warn",
    "duplicates": "warn"
  }
}
